<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- ================== ADMIN PANEL SECURITY ================== -->
    
    <!-- URL REWRITING FOR SPA -->
    <rewrite>
      <rules>
        <!-- Force HTTPS Redirect -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/admin/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- SPA Routing - Redirect all requests to index.html -->
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api" negate="true" />
          </conditions>
          <action type="Rewrite" url="/admin/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- ================== SECURITY HEADERS (ENHANCED FOR ADMIN) ================== -->
    <httpProtocol>
      <customHeaders>
        <!-- Strict Transport Security (HSTS) -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
        
        <!-- Content Security Policy - STRICTER for admin -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self';" />
        
        <!-- X-Content-Type-Options -->
        <add name="X-Content-Type-Options" value="nosniff" />
        
        <!-- X-Frame-Options - DENY for admin (no iframes) -->
        <add name="X-Frame-Options" value="DENY" />
        
        <!-- X-XSS-Protection -->
        <add name="X-XSS-Protection" value="1; mode=block" />
        
        <!-- Referrer-Policy - NO referrer for admin -->
        <add name="Referrer-Policy" value="no-referrer" />
        
        <!-- Permissions-Policy - Restrict ALL features -->
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=(), usb=()" />
        
        <!-- Remove server information -->
        <remove name="X-Powered-By" />
        <remove name="Server" />
        
        <!-- Cache Control - NO caching for admin pages -->
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate, proxy-revalidate" />
        <add name="Pragma" value="no-cache" />
        <add name="Expires" value="0" />
      </customHeaders>
    </httpProtocol>

    <!-- ================== IP RESTRICTIONS (OPTIONAL) ================== -->
    <!-- Uncomment and configure to restrict admin access by IP -->
    <!--
    <security>
      <ipSecurity allowUnlisted="false">
        <!- - Allow specific IP addresses - ->
        <add ipAddress="192.168.1.100" allowed="true" />
        <add ipAddress="10.0.0.0" subnetMask="255.255.255.0" allowed="true" />
        
        <!- - Or allow specific domain users - ->
        <!- - <add domainName="yourdomain.com" allowed="true" /> - ->
      </ipSecurity>
    </security>
    -->

    <!-- ================== REQUEST FILTERING (STRICTER) ================== -->
    <security>
      <requestFiltering>
        <!-- Smaller request limits for admin -->
        <requestLimits maxAllowedContentLength="10485760" maxQueryString="1024" maxUrl="2048" />
        
        <!-- Block dangerous file extensions -->
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".git" allowed="false" />
          <add fileExtension=".gitignore" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".map" allowed="false" />
        </fileExtensions>
        
        <!-- Block ALL except GET and POST -->
        <verbs>
          <add verb="TRACE" allowed="false" />
          <add verb="TRACK" allowed="false" />
          <add verb="DELETE" allowed="false" />
          <add verb="PUT" allowed="false" />
          <add verb="PATCH" allowed="false" />
          <add verb="OPTIONS" allowed="false" />
        </verbs>
        
        <!-- Block suspicious query strings -->
        <denyQueryStringSequences>
          <add sequence="../" />
          <add sequence="..\\" />
          <add sequence=":" />
          <add sequence="&lt;" />
          <add sequence="&gt;" />
          <add sequence="exec" />
          <add sequence="union" />
          <add sequence="select" />
          <add sequence="insert" />
          <add sequence="drop" />
        </denyQueryStringSequences>
        
        <!-- Block hidden segments -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".env" />
          <add segment=".env.local" />
          <add segment=".env.production" />
          <add segment="node_modules" />
          <add segment="src" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- ================== DISABLE DIRECTORY BROWSING ================== -->
    <directoryBrowse enabled="false" />

    <!-- ================== ERROR PAGES ================== -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="401" />
      <error statusCode="401" path="/admin/index.html" responseMode="ExecuteURL" />
      <remove statusCode="403" />
      <error statusCode="403" path="/admin/index.html" responseMode="ExecuteURL" />
      <remove statusCode="404" />
      <error statusCode="404" path="/admin/index.html" responseMode="ExecuteURL" />
      <remove statusCode="500" />
      <error statusCode="500" path="/admin/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- ================== DEFAULT DOCUMENTS ================== -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- ================== FAILED REQUEST TRACING (SECURITY MONITORING) ================== -->
    <!-- Enable in IIS Manager: Failed Request Tracing Rules -->
    <tracing>
      <traceFailedRequests>
        <add path="*">
          <traceAreas>
            <add provider="WWW Server" areas="Authentication,Security,Filter,StaticFile,CGI,Compression,Cache,RequestNotifications" verbosity="Verbose" />
          </traceAreas>
          <failureDefinitions statusCodes="400-999" />
        </add>
      </traceFailedRequests>
    </tracing>

  </system.webServer>

  <!-- ================== REMOVE SERVER HEADER ================== -->
  <system.web>
    <httpRuntime enableVersionHeader="false" />
    <customErrors mode="On" defaultRedirect="/admin/index.html" />
  </system.web>
</configuration>
